# Copy to .env and fill in. Nothing here is read from a file by the server: the
# values are environment variables, and this file only names them. `.env` is
# gitignored; this example is the half that ships.
#
# A board session is a credential, not a setting. It belongs in the environment
# for the same reason a password does - a value pasted into profiles.json or
# into a command line ends up in a shell history, a backup, or a diff.

# TalentMove: the session cookie of a paid account. Without it the board answers
# 401 across the whole address. Copy the whole Cookie header value.
TM_COOKIE=paste-the-cookie-header-value-here

# Which profile file to read, and which profile inside it. Both optional:
# profiles.json and its own `active` key are the defaults.
JOBS_PROFILES=profiles.json
JOBS_PROFILE=default

# Where the store lives. Optional; the default is jobs.db next to server.mjs.
# Point it elsewhere to run against a scratch database.
JOBS_DB_PATH=jobs.db
